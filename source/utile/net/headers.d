mixin(lowerGen);

private:

string lowerGen()
{
	string s;

	static foreach (h; EnumMembers!Header)
	{
		s ~= __traits(identifier, h) ~ `="` ~ h.toLower ~ `",`;
	}

	return `enum HeaderNormalized {` ~ s ~ '}';
}
