{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run All Tests",
			"type": "shell",
			"command": "dub test :test",
			"problemMatcher": [
				"$dmd"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Build wasm",
			"type": "shell",
			"command": "dub build -a wasm32-unknown-emscripten --compiler=ldc2 :test",
			"problemMatcher": [
				"$dmd"
			]
		}
	]
}
